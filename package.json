{
  "name": "oauth-web",
  "version": "1.1.2",
  "description": "企业统一身份认证（OAuth 2.1）登录 / 授权前端 —— Enterprise identity frontend: login, registration and OAuth 2.1 authorization",
  "license": "GPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=22.6",
    "npm": ">=10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yijiu2025/oauth-web.git"
  },
  "homepage": "https://github.com/yijiu2025/oauth-web",
  "scripts": {
    "dev": "vite",
    "doctor": "node scripts/doctor.mjs",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "verify": "npm run lint && npm test && npm run build && npx vite build --outDir dist-nopwa && node e2e/verify-all.mjs --only static",
    "verify:static": "node e2e/verify-all.mjs --only static",
    "verify:all": "node e2e/verify-all.mjs",
    "probe:up": "node scripts/probe.mjs up",
    "probe:down": "node scripts/probe.mjs down",
    "probe:status": "node scripts/probe.mjs status",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit --omit=dev --fix"
  },
  "dependencies": {
    "@vee-validate/zod": "^4.15.1",
    "axios": "^1.16.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "skinsuite": "^1.0.0",
    "stable-deviceid": "^1.0.3",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.32",
    "vue-i18n": "^11.4.2",
    "vue-router": "^5.0.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.6.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.5.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "fast-glob": "^3.3.3",
    "globals": "^17.11.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.14",
    "sass": "^1.99.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.3.5",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.2.8"
  },
  "overrides": {
    "vitepress": {
      "vite": "^6.4.4"
    }
  }
}
