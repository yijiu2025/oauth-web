# ============================================================
# oauth-web（登录 / SSO 前端）环境变量
#
# 文件角色（四个文件的变量顺序完全一致，按环境叠加取值）：
#   .env               本地基础配置，不入库 —— 本机默认值
#   .env.development   npm run dev 时覆盖 .env
#   .env.production    npm run build 时覆盖 .env
#   .env.example       模板：复制为 .env 后按需修改（脱敏，可入库）
#   .env.production.local  本机生产构建的临时覆盖，不入库（匹配 *.local）
#
# 约定：四个文件都列出全部变量，用不到的留空即"不启用"，
# 不要删除行 —— 删除后人不知道它存在过。
# ============================================================

# ------------------------------------------------------------
# 1. 基础
# ------------------------------------------------------------

# 后端 API 基地址。
#   · 开发环境：vite.config.ts 的 proxy 把 /api 转发到这个地址，填后端本地地址即可
#   · 生产环境：留空 = 与前端同源部署（推荐，无跨域问题）；跨域时填完整 origin
#   · 留空时代码内默认 http://localhost:3000（src/utils/request.ts）
VITE_API_BASE_URL=http://localhost:3000

# ------------------------------------------------------------
# 2. 页面版式（部署级默认 UI：整站换版式，不用改代码）
# ------------------------------------------------------------
# 三个登录相关页面各自的默认版式。合法值 = src/theme/themes/ 下的
# **主题包目录名**（一个主题包 = 一种版式，如 compact）；留空 = 基础版式。
#
# 选择优先级（高 → 低）：
#   URL ?view=<id>  >  主题包/配色记录里的 views 声明  >  本变量  >  当前主题包名
# URL 显式写错时不回落，直接落当前包 —— 静默换 UI 比看到当前包难排查得多。
#
# 完整机制见 docs/theme-replacement.md（总文档：docs/frontend/theme-replacement.md）。
VITE_LOGIN_VIEW=
VITE_REGISTER_VIEW=
VITE_FORGOT_PASSWORD_VIEW=

# ------------------------------------------------------------
# 3. 人机验证（两套可选，同时开启时 Turnstile 优先）
# ------------------------------------------------------------

# --- hCaptcha（海外场景）---
# 与后端 .env 的 RECAPTCHA_ENABLED 对应；false 时下面的 key 不加载，留空占位即可。
VITE_RECAPTCHA_ENABLED=false
# hCaptcha site key（site key 本就公开，随前端下发；secret 只放后端）。
# 下面是 hCaptcha 官方测试 key（永远返回验证通过），联调用；上线换真实 key。
VITE_RECAPTCHA_SITE_KEY=649e9b18-031a-4610-a682-ca7a257ed726

# --- Cloudflare Turnstile（国内 / 隐私场景推荐）---
# 加载比 hCaptcha 快（~50KB vs ~200KB），国内访问约 200ms。
VITE_TURNSTILE_ENABLED=false
# Turnstile site key，从 Cloudflare Dashboard 获取。
# ⚠️ site key 虽随前端下发，也不要写进任何提交 / 对话 / 截图；轮换后同步部署平台。
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA_REPLACE_WITH_YOUR_SITE_KEY

# ------------------------------------------------------------
# 4. 密码重置方式
# ------------------------------------------------------------
# 与后端 .env 的 PASSWORD_RESET_MODE 对应，两边必须一致：
#   code = 验证码重置（默认）  /  link = 邮件链接重置
VITE_PASSWORD_RESET_MODE=code

# ------------------------------------------------------------
# 5. 第三方登录（社交登录）
# ------------------------------------------------------------
# 授权端点：只接受站内相对路径（/ 开头且非 //），如 /api/oauth/social/authorize。
# 刻意不支持绝对地址 —— 端点一旦可由外部指定，"把用户送去任意外域"
# 就从漏洞变成配置问题。未配置时点击会提示"尚未配置授权地址"，不静默失败。
VITE_SOCIAL_ENDPOINT=

# 默认展示哪几个 provider，逗号分隔：wechat,alipay,qq,weibo,github,apple
# 单次访问可用 URL 参数覆盖：?social=wechat,qq（联调最方便）
# 留空 = 登录页不渲染第三方登录行（默认外观零变化）。
VITE_SOCIAL_PROVIDERS=

# ------------------------------------------------------------
# 6. iframe 父应用 origin 白名单（SSO 嵌入的安全边界）
# ------------------------------------------------------------
# oauth-web 被别的应用用 iframe 嵌进弹窗时，只有命中本白名单的父 origin
# 才会收到 postMessage（SSO_READY 握手 / 主题同步）—— 防恶意页面嵌入窃登录态。
#
# 🔴 漏配的症状是"慢"不是报错：宿主弹窗「正在加载安全登录」要等满 3s
#    兜底超时（SSO_READY 被拒发），控制台见
#    「[SSO] 拒绝 postMessage：父 origin 未授权 <origin>」。排查先看这行。
# 🔴 只写"嵌 oauth-web 的父应用"origin；别把本应用自己的端口
#    （5174 / 5175）写进来 —— 它是被嵌方，不是父应用。
# 🔴 生产必须改成真实父应用 origin；留空会回落到 localhost:5176 开发兜底值，
#    仅限本机联调可接受。
#
# 本地开发常用宿主：posecraft 跑 5176、retroweb 跑 5177（*.localhost 走 allowedHosts）。
VITE_ALLOWED_PARENT_ORIGINS='http://localhost:5176,http://127.0.0.1:5176,http://posecraft.localhost:5176,http://aaa.localhost:5176,http://localhost:5177,http://127.0.0.1:5177,http://retroweb.localhost:5177'

# ------------------------------------------------------------
# 7. 请求签名 appKey（H5 签名，弱防爬）
# ------------------------------------------------------------
# 前后端共享，必须与后端 .env 的 SIGN_APP_KEY 相同。
# ⚠️ 前端反编译可拿到它，真正敏感操作仍靠登录态 + 权限校验 ——
#    改这个值只是提高脚本批量请求的门槛。
VITE_SIGN_APP_KEY=coreflow-sign-key-2026-change-me

# ------------------------------------------------------------
# 8. 后端主题下发（换配色不改前端代码）
# ------------------------------------------------------------
# 配置后，前端启动时请求 GET {端点}?client_id=<clientId>，拿部署方默认的
# 配色 / 明暗 / token 覆写（同一份构建产物服务多个品牌）。
# 未配置 = 整个机制不生效（不发任何请求，零副作用）。
# 接口契约与失败策略见 docs/theme-replacement.md 第七节。
VITE_THEME_ENDPOINT=
