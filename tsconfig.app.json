{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "preserve",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      /* ⚠️ 这几个别名与 `config/aliases.ts` 是**同一份语义的两处表达**：
         vite.config.ts / vitest.config.ts 从那个文件 import（唯一来源），
         而 compilerOptions.paths 是静态 JSON、无法求值 TS 模块，只能手写这份副本。
         🔴 改任何一条都必须**两处同改** —— 关卡 `e2e/verify-alias-single-source.mjs`
            会比对二者是否一致，漂移即红。 */
      "@/*": ["./src/*"],
      "stable-deviceid": ["../packages/shared-device/src/index.ts"],
      "stable-deviceid/*": ["../packages/shared-device/src/*"],
      "skinsuite": ["../packages/theme-core/src/index.ts"],
      "skinsuite/vue": ["../packages/theme-core/src/vue/index.ts"],
      "skinsuite/vue/panel": ["../packages/theme-core/src/vue/debug/panel.ts"],
      "skinsuite/vite": ["../packages/theme-core/src/vite/index.ts"],
      /* 🔴 `vue` 必须钉到宿主安装的那份：本地包源码直供后，theme-core 里的
         `import 'vue'` 按 node 解析会命中它自带的 node_modules/vue（版本可与宿主
         不同）—— 类型世界出现两份 vue 声明，症状成族：`app.use(theme)` 的 install
         签名（App 类型）跨声明比对失败（ts2769）；pinia 不认库里的 ref（RefSymbol
         是另一份声明），store 取值拿到 Ref 本体。此映射把整个 program 的 vue 统一
         到宿主安装份。与 aliases.ts 的 `vue` 键同源，关卡 verify-alias-single-source
         盯防。standalone 形态下该路径不存在，TS 自动回落 node_modules 正常解析。 */
      "vue": ["../node_modules/vue"]
    }
  },
  "include": [
    "src/**/*",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/auto-import.d.ts",
    "src/components.d.ts",
    "../packages/shared-device/src/**/*.ts",
    "../packages/theme-core/src/**/*.ts",
    /* Vue 绑定层（面板 / 父窗口同步）由宿主侧类型闸门负责检查：
       包自己的 tsc 只跑纯 TS，`.vue` 只能在这里被 vue-tsc 看到。 */
    "../packages/theme-core/src/**/*.vue"
  ]
}
